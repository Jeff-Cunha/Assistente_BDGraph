# Copie para .env e configure localmente. Não envie a chave ao chat ou GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Neo4j (parte 2). Copie para .env e escolha uma senha local (mínimo 8 caracteres).
# NUNCA versione o .env. Os valores abaixo, exceto a senha, são o padrão do docker-compose.yml.
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
