{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphRAG extraction contract 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extraction_method", "input_chunk_ids", "concepts", "relations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "extraction_method": {"enum": ["manual_reference", "llm_candidates"]},
    "input_chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chunk_id", "quote"],
        "properties": {"chunk_id": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}
      }
    },
    "review": {"enum": ["pending", "accepted", "flagged"]},
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": ["concept_id", "canonical_name", "name_pt", "aliases", "category", "description_pt", "evidence", "review_status"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^C_[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "canonical_name": {"type": "string", "minLength": 1},
        "name_pt": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "category": {"enum": ["general", "structure", "constraint", "operation", "normalization"]},
        "description_pt": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "review_status": {"$ref": "#/$defs/review"},
        "review_note": {"type": "string"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "source", "type", "target", "assertion_kind", "evidence", "review_status"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^R_[a-zA-Z0-9_]+$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "type": {"enum": ["IS_A", "SUPPORTS", "REQUIRES", "GOVERNS", "TYPICALLY_USED_IN", "COMBINES", "HAS_FORM", "PRESERVES"]},
        "assertion_kind": {"enum": ["explicit", "inferred"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "review_status": {"$ref": "#/$defs/review"},
        "review_note": {"type": "string"}
      }
    }
  }
}
