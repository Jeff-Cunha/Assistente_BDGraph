{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounded answer from the LLM stage (parte 4) 0.1.0",
  "$comment": "Every claim cites evidence identifiers resolved here to chunks and source URLs. support.level is a documentary rule, never a model estimate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question",
    "answered",
    "answer_pt",
    "claims",
    "dropped_claims",
    "citations",
    "sources",
    "support",
    "limitations"
  ],
  "allOf": [
    {
      "if": {"properties": {"answered": {"const": false}}},
      "then": {"properties": {"claims": {"maxItems": 0}, "citations": {"maxItems": 0}}}
    }
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "question": {"type": "string", "minLength": 1},
    "answered": {"type": "boolean"},
    "answer_pt": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "dropped_claims": {"type": "array", "items": {"$ref": "#/$defs/dropped"}},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "support": {"$ref": "#/$defs/support"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cypher", "parameters"],
      "properties": {
        "cypher": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "paths": {"type": "array"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_digest": {"type": ["string", "null"]},
        "settings": {"type": "object"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^E[0-9]+$"}
        }
      }
    },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "reason"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "reason": {"const": "claim_without_evidence"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "chunk_id",
        "document_id",
        "title",
        "source_url",
        "section_path",
        "quote",
        "review_status",
        "origin",
        "quote_verified"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^E[0-9]+$"},
        "chunk_id": {"type": "string", "pattern": "^D[0-9]{2}_(?:C[0-9]{3}|F[0-9]{3}_S[0-9]{3})$"},
        "document_id": {"type": ["string", "null"], "pattern": "^D[0-9]{2}$"},
        "title": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]},
        "section_path": {"type": ["array", "null"], "items": {"type": "string"}},
        "quote": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["accepted", "pending", "flagged"]},
        "origin": {"enum": ["graph", "vector", "concept"]},
        "quote_verified": {"type": ["boolean", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "source_url", "chunk_ids"],
      "properties": {
        "document_id": {"type": ["string", "null"], "pattern": "^D[0-9]{2}$"},
        "title": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]},
        "chunk_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "coverage",
        "claims_with_evidence",
        "claims_without_evidence",
        "distinct_chunks",
        "distinct_documents",
        "evidence_review",
        "unverified_quotes",
        "reasons"
      ],
      "properties": {
        "level": {"enum": ["insufficient", "low", "medium", "high"]},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "claims_with_evidence": {"type": "integer", "minimum": 0},
        "claims_without_evidence": {"type": "integer", "minimum": 0},
        "distinct_chunks": {"type": "integer", "minimum": 0},
        "distinct_documents": {"type": "integer", "minimum": 0},
        "evidence_review": {"enum": ["accepted", "mixed", "none"]},
        "unverified_quotes": {"type": "integer", "minimum": 0},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
